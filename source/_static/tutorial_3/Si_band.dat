print_qc      : TRUE
#output_detail : Normal
output_detail : Verbose
do_properties : True

task : SinglePoint

cutoff_energy : 500 eV
xc_functional : PBE

write_denskern : F
write_tightbox_ngwfs : F
maxit_ngwf_cg : 200

use_cmplx_ngwfs : T
extend_ngwf : T T T
pub_ngwfs_init_recip : T
kpoint_method : PW

num_kpars : 4

edft : T
edft_maxit : 4
edft_smearing_width : 0.2 eV
eigensolver_abstol : -1
eigensolver_orfac : -1
occ_mix : 1.0

